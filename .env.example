# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URI=amqp://guest:guest@localhost:5672

# Producer
PRODUCER_PORT=3000
PUBLISH_RETRIES=5
PUBLISH_RETRY_DELAY_MS=500

# Consumer
CONSUMER_PREFETCH=10
CONSUMER_MAX_RETRIES=3

# Telegram notifier
TELEGRAM_BOT_TOKEN=
TELEGRAM_DRY_RUN=true
TELEGRAM_PREFETCH=5
TELEGRAM_MAX_RETRIES=3
TELEGRAM_API_BASE_URL=https://api.telegram.org
